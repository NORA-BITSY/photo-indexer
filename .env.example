# Photo Indexer environment (copy to .env and adjust values)
# Do not commit .env; it contains secrets.

# General
TZ=UTC
PUID=1000
PGID=1000


# Immich
# PRODUCTION: pin IMMICH_VERSION / IMMICH_DB_IMAGE / OLLAMA_VERSION etc. to specific
# tags or sha256 digests (e.g. ghcr.io/.../immich-server@sha256:...). Never use :latest.
IMMICH_VERSION=release
IMMICH_PORT=2283
IMMICH_API_KEY=  # create in Immich UI: Account Settings -> API Keys
IMMICH_DB_IMAGE=ghcr.io/immich-app/postgres:16-vectorchord0.3.0-pgvectors0.2.0
# Storage paths (use absolute paths on Linux server/NAS; originals + DB should have 3-2-1 backups)
UPLOAD_LOCATION=/srv/photo-indexer/immich/upload
LIBRARY_LOCATION=/srv/photo-indexer/library
STAGING_LOCATION=/srv/photo-indexer/staging
DB_DATA_LOCATION=/srv/photo-indexer/postgres
METADATA_DUMP_LOCATION=/srv/photo-indexer/metadata

# Database (Immich + enrich schema in same Postgres instance)
DB_USERNAME=postgres
DB_PASSWORD=change_me_to_a_strong_password
DB_DATABASE_NAME=immich

# Local VLM (Ollama, local-only; CPU fallback OK)
OLLAMA_PORT=11434
OLLAMA_VERSION=0.5.4  # pin for production; never use :latest
OLLAMA_KEEP_ALIVE=24h
VLM_MODEL=llava
# Suggested models: llava, llava:13b, llava-llama3, moondream (smaller/faster), bakllava
# Pull after startup: docker compose exec ollama ollama pull llava

# Optional enrichment worker
IMMICH_ANALYZE_IMAGE=ghcr.io/timasoft/immich-analyze:latest
ANALYZE_INTERVAL=3600
ANALYZE_DRY_RUN=false

# Optional ExifTool job container
EXIFTOOL_IMAGE=ghcr.io/linuxserver/exiftool:latest

# Suggested staging layout under STAGING_LOCATION:
#   /srv/photo-indexer/staging/icloud/   (icloudpd exports)
#   /srv/photo-indexer/staging/takeout/  (Google Photos Takeout unpacked)
#   /srv/photo-indexer/staging/android/  (Samsung/Pixel byte-perfect copies/DCIM)
#   /srv/photo-indexer/staging/local/    (existing local folders)